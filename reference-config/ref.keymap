/*
 * Exercises every binding this module adds, so CI fails if a behaviour stops
 * resolving — not just if the widgets stop compiling.
 */

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/block_timer.h>
#include <dt-bindings/zmk/prospector_brightness.h>

/ {
    behaviors {
        blk: block_timer {
            compatible = "zmk,behavior-block-timer";
            #binding-cells = <1>;
        };

        bri: prospector_brightness {
            compatible = "zmk,behavior-prospector-brightness";
            #binding-cells = <1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base_layer {
            display-name = "Base";
            bindings = <
&kp Q  &kp W  &kp E          &kp R            &kp T          &kp Y  &kp U  &kp I  &kp O  &kp P
&blk 15 &blk 30 &blk 45      &blk 60          &blk 90        &kp H  &kp J  &kp K  &kp L  &kp SEMI
&blk BLK_START &blk BLK_STOP &bri BRI_UP      &bri BRI_DOWN  &kp B  &kp N  &kp M  &kp COMMA &kp DOT &kp FSLH
                             &kp LGUI &kp SPACE &mo 1        &kp RET &kp BSPC &kp RALT
            >;
        };

        second_layer {
            /* Deliberately Japanese: the ref-dial-jp build target turns on
             * CONFIG_PROSPECTOR_LAYER_FONT_JP, so this exercises the UTF-8
             * path through the layer label. The other targets keep it too,
             * where it simply renders as a missing glyph — harmless in CI. */
            display-name = "集中";
            bindings = <
&bt BT_SEL 0 &bt BT_SEL 1 &bt BT_SEL 2 &bt BT_SEL 3 &bt BT_CLR  &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans                              &trans &trans &trans &trans &trans
&trans &trans &trans &trans &trans                              &trans &trans &trans &trans &trans
                     &trans &trans &trans                       &trans &trans &trans
            >;
        };
    };
};
